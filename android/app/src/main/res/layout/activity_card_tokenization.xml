<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pagamento com cartão"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ambiente seguro Mercado Pago"
            android:textColor="#666666"
            android:textSize="15sp" />

        <!-- ================================================= -->
        <!-- VALOR -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Valor"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/amountTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="R$ 0,00"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- SANDBOX -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#EAF4FF"
            android:padding="14dp"
            android:text="AMBIENTE DE TESTE — nenhum dinheiro real será movimentado."
            android:textColor="#123A63"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- TITULAR -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nome do titular"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cardHolderNameEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:hint="Nome impresso no cartão"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingHorizontal="12dp" />

        <!-- ================================================= -->
        <!-- CPF -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CPF do titular"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cpfEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:digits="0123456789"
            android:hint="Somente números"
            android:inputType="number"
            android:maxLength="11"
            android:maxLines="1"
            android:paddingHorizontal="12dp" />

        <!-- ================================================= -->
        <!-- NÚMERO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Número do cartão"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.mercadopago.sdk.android.coremethods.ui.components.textfield.cardnumber.xml.CardNumberTextField
            android:id="@+id/cardNumberTextField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background" />

        <!-- ================================================= -->
        <!-- MODALIDADE / BANDEIRA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/paymentMethodLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Modalidade"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/paymentMethodSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- ================================================= -->
        <!-- VALIDADE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Validade"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.mercadopago.sdk.android.coremethods.ui.components.textfield.expirationdate.xml.ExpirationDateTextField
            android:id="@+id/expirationDateTextField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background" />

        <!-- ================================================= -->
        <!-- CVV -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Código de segurança (CVV)"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.mercadopago.sdk.android.coremethods.ui.components.textfield.securitycode.xml.SecurityCodeTextField
            android:id="@+id/securityCodeTextField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background" />

        <!-- ================================================= -->
        <!-- PARCELAS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/installmentLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Parcelas"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/installmentSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- ================================================= -->
        <!-- ERRO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/errorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#B3261E"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- ================================================= -->
        <!-- PAGAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/tokenizeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="PAGAR"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- CANCELAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="CANCELAR" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Os dados sensíveis do cartão são processados pelo Mercado Pago."
            android:textColor="#777777"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>